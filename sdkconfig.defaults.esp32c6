# ESP32-C6 Super Mini (applied when target is esp32c6)

# Prefer 160 MHz on C6 (C3 defaults often used 80 MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# RC Tank Hardware Pins (overridable in menuconfig)
# LEDs 0/1/2 | right motors 14/18 | left motors 19/20 | nSLEEP 23 | servo 21 | DF TX 22
CONFIG_PIN_RIGHT_IN1=14
CONFIG_PIN_RIGHT_IN2=18
CONFIG_PIN_LEFT_IN1=19
CONFIG_PIN_LEFT_IN2=20
CONFIG_PIN_MOTOR_NSLEEP=23
CONFIG_PIN_HEADLIGHT=0
CONFIG_PIN_CANNON_LED=1
CONFIG_PIN_MG_LED=2
CONFIG_PIN_TURRET_SERVO=21
CONFIG_PIN_DFPLAYER_TX=22
CONFIG_PIN_DFPLAYER_RX=-1
