# ESP32-C6 Super Mini (applied when target is esp32c6)

# Prefer 160 MHz on C6 (C3 defaults often used 80 MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# RC Tank Hardware Pins — flipped PCB install defaults
# Motors (order reversed): R=3/2, L=1/0; nSLEEP 6; LEDs 20/19/18; servo 21; DF TX 22
CONFIG_PIN_RIGHT_IN1=3
CONFIG_PIN_RIGHT_IN2=2
CONFIG_PIN_LEFT_IN1=1
CONFIG_PIN_LEFT_IN2=0
CONFIG_PIN_MOTOR_NSLEEP=6
CONFIG_PIN_HEADLIGHT=20
CONFIG_PIN_CANNON_LED=19
CONFIG_PIN_MG_LED=18
CONFIG_PIN_TURRET_SERVO=21
CONFIG_PIN_TURRET_PITCH=23
CONFIG_PIN_DFPLAYER_TX=22
CONFIG_PIN_DFPLAYER_RX=-1
