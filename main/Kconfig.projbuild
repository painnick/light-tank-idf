menu "RC Tank Hardware Pins"

    config PIN_RIGHT_IN1
        int "Right track IN1 (Motor-IN-A1)"
        range 0 30
        default 0
        help
            DRV8833 right track IN1. C6 Super Mini default: GPIO0.
            Avoid 8/9/12/13/15 (boot/USB). Prefer non-strapping for motors.

    config PIN_RIGHT_IN2
        int "Right track IN2 (Motor-IN-A2)"
        range 0 30
        default 1
        help
            DRV8833 right track IN2. Default: GPIO1.

    config PIN_LEFT_IN1
        int "Left track IN1 (Motor-IN-B1)"
        range 0 30
        default 19
        help
            DRV8833 left track IN1. Default: GPIO19 (right header).

    config PIN_LEFT_IN2
        int "Left track IN2 (Motor-IN-B2)"
        range 0 30
        default 20
        help
            DRV8833 left track IN2. Default: GPIO20 (right header).

    config PIN_CANNON_LED
        int "Cannon LED (CannonLED)"
        range 0 30
        default 6
        help
            Cannon LED. Default GPIO6 (left header cluster with MG/headlight).

    config PIN_MG_LED
        int "Gatling / MG LED"
        range 0 30
        default 7
        help
            Gatling LED. Default GPIO7 (left header, next to cannon LED).

    config PIN_HEADLIGHT
        int "Headlight (HeadLight)"
        range 0 30
        default 2
        help
            Headlight LED. Default GPIO2 (left header, freed from left track).
            Toggled by gamepad Y button (edge); off on disconnect.

    config PIN_TURRET_SERVO
        int "Turret servo PWM (TurretServo)"
        range 0 30
        default 14
        help
            SG90 PWM via LEDC. Default: GPIO14 (right header).

    config PIN_DFPLAYER_TX
        int "DFPlayer UART TX (ESP -> DFPlayer RX)"
        range 0 30
        default 18
        help
            UART1 TX only to DFPlayer RX. Default: GPIO18 (right header).
            This project does not wire DFPlayer UART feedback.

    config PIN_DFPLAYER_RX
        int "DFPlayer UART RX (-1 = unused / TX-only)"
        range -1 30
        default -1
        help
            Leave at -1 (default). RX is not used on the C6 Super Mini PCB.

endmenu
