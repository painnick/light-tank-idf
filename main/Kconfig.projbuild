menu "RC Tank Hardware Pins"

    config PIN_RIGHT_IN1
        int "Right track IN1 (Motor-IN-A1)"
        range 0 30
        default 3
        help
            DRV8833 right track IN1. Default: GPIO3 (motor cluster order reversed).

    config PIN_RIGHT_IN2
        int "Right track IN2 (Motor-IN-A2)"
        range 0 30
        default 2
        help
            DRV8833 right track IN2. Default: GPIO2.

    config PIN_LEFT_IN1
        int "Left track IN1 (Motor-IN-B1)"
        range 0 30
        default 1
        help
            DRV8833 left track IN1. Default: GPIO1.

    config PIN_LEFT_IN2
        int "Left track IN2 (Motor-IN-B2)"
        range 0 30
        default 0
        help
            DRV8833 left track IN2. Default: GPIO0.

    config PIN_MOTOR_NSLEEP
        int "DRV8833 nSLEEP (active high enable)"
        range 0 30
        default 6
        help
            DRV8833 nSLEEP: LOW=sleep (outputs Hi-Z), HIGH=run.
            Default GPIO6. PCB: ~10k pull-down to GND so boot keeps sleep.
            Firmware: LOW until motor pins ready, then HIGH. Off on pad disconnect.

    config PIN_HEADLIGHT
        int "Headlight (HeadLight)"
        range 0 30
        default 20
        help
            Headlight LED. Default GPIO20.
            Toggled by gamepad Y button (edge); off on disconnect.

    config PIN_CANNON_LED
        int "Cannon LED (CannonLED)"
        range 0 30
        default 19
        help
            Cannon LED. Default GPIO19.

    config PIN_MG_LED
        int "Gatling / MG LED"
        range 0 30
        default 18
        help
            Gatling LED. Default GPIO18.

    config PIN_TURRET_SERVO
        int "Turret yaw servo PWM (left/right)"
        range 0 30
        default 21
        help
            Turret horizontal (yaw) SG90 PWM. Default: GPIO21.

    config PIN_TURRET_PITCH
        int "Turret pitch servo PWM (up/down)"
        range 0 30
        default 23
        help
            Turret elevation (pitch) SG90 PWM. Default: GPIO23.
            Center 80 on connect; range 60-90; D-Pad up/down steps of 5 deg; idle detach 3s.

    config PIN_DFPLAYER_TX
        int "DFPlayer UART TX (ESP -> DFPlayer RX)"
        range 0 30
        default 22
        help
            UART1 TX only to DFPlayer RX. Default: GPIO22.
            This project does not wire DFPlayer UART feedback.

    config PIN_DFPLAYER_RX
        int "DFPlayer UART RX (-1 = unused / TX-only)"
        range -1 30
        default -1
        help
            Leave at -1 (default). RX is not used on the C6 Super Mini PCB.

endmenu
